{
  "name": "permapath",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "deploy:resolver": "node scripts/deploy.mjs resolver",
    "deploy:editor": "node scripts/deploy.mjs editor",
    "deploy:worker": "node scripts/check-editor.mjs && cd worker && node --env-file=../.env ../node_modules/wrangler/bin/wrangler.js deploy",
    "build:cli": "node scripts/build-cli.mjs",
    "check:editor": "node scripts/check-editor.mjs"
  },
  "devDependencies": {
    "@dha-team/arbundles": "^1.0.4",
    "axios": "^1.20.0",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "playwright": "^1.63.0",
    "qrcode-generator": "^2.0.4",
    "wrangler": "^4.147.0"
  },
  "bin": {
    "permapath": "cli/permapath.mjs"
  },
  "license": "MIT"
}
